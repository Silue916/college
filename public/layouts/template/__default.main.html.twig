<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{ page_description|default(site.name|default('Établissement scolaire'))|e }}">
  <title>{% block title %}{{ page_title|default(site.name|default('Établissement scolaire'))|e }}{% endblock %}</title>
  <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
        crossorigin="anonymous">
  <link rel="stylesheet" href="{{ __css('site/public-site') }}">
</head>
<body>
  {{ include('layouts/display/__header.html.html') }}
  <main id="contenu">
    {% block content %}{% endblock %}
  </main>
  {{ include('layouts/display/__footer.html.html') }}
</body>
</html>
